# 温故 · 环境变量模板
# 复制为 .env 后按本机情况填写：cp .env.example .env
# .env 已被 .gitignore 挡住，绝不提交。

# ---- seekdb（唯一数据存储，MySQL 协议）----
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=wengu

# ---- embedding ----
# 维度改动 = 整库重建：chunks.emb 是 VECTOR(1024)，权威值同时记在 kb_meta.embed_dim
EMBED_DIM=1024
