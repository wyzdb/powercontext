{
  "name": "stepfun-kb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "pnpm prepare:ort && pnpm prepare:seekdb && pnpm ensure:models",
    "prepare:ort": "node scripts/prepare-ort.mjs",
    "prepare:seekdb": "node scripts/prepare-seekdb.mjs",
    "ensure:models": "node scripts/ensure-models.mjs",
    "models:fetch": "node scripts/fetch-models.mjs",
    "check:linux": "bash scripts/check-linux-deps.sh",
    "predev": "pnpm prepare:ort && pnpm prepare:seekdb && pnpm ensure:models",
    "predev:web": "pnpm prepare:ort && pnpm ensure:models",
    "prebuild": "pnpm prepare:ort && pnpm ensure:models",
    "dev": "concurrently -k -n server,web -c blue,green \"WATCH=1 bash scripts/run-embedded.sh\" \"vite\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "bench": "node scripts/bench-all.mjs",
    "bench:once": "node scripts/bench-playwright.mjs",
    "bench:aggregate": "node scripts/aggregate-bench.mjs",
    "check:saturation": "node scripts/check-saturation.mjs",
    "demo": "node scripts/demo-playwright.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@huggingface/transformers": "3.8.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "seekdb": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "pino-pretty": "^13.2.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@seekdb/js-bindings": "1.4.0"
  }
}
