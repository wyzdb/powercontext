# PowerContext Server 环境变量示例（占位值，勿提交真实凭据）
# 正式使用时用 `powercontext config init` 生成，再按需要合并下面几项。
# 版本：powercontext 1.4.1

# ---- 数据目录（SQLite 与调度状态）----
POWERCONTEXT_HOME=/srv/powercontext
POWERCONTEXT_SERVER_DATABASE_KIND=sqlite

# ---- 监听 ----
# 默认 127.0.0.1；Dify 跑在 Docker 里，必须绑 0.0.0.0 并配合安全组限制来源
POWERCONTEXT_SERVER_HTTP_HOST=0.0.0.0
POWERCONTEXT_SERVER_HTTP_PORT=8000

# ---- 鉴权 ----
# 演示部署：关闭鉴权 + 内网访问。二者必须同时满足，否则拒绝启动。
# 公网部署请改为 enforced + AUTH_TOKEN，并在 Dify HTTP 节点加 Bearer 头。
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_ALLOW_UNAUTHENTICATED_NON_LOOPBACK=true
# POWERCONTEXT_SERVER_ACCESS_MODE=enforced
# POWERCONTEXT_SERVER_AUTH_TOKEN=replace-with-a-long-random-token

# ---- Dashboard（证据截图入口）----
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=true

# ---- 记忆抽取风格：conversation 更适合人物/关系/事件 ----
POWERCONTEXT_SERVER_RUNTIME_MEMORY_EXTRACTION_PROFILE=conversation

# ---- 语义检索（中文强烈建议开启；推荐用 config init 向导写入）----
# 参考：POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_MODEL=openai:text-embedding-v3
#       POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_PROFILE_ID=dashscope-v3
#       POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_DIMENSION=1024
#       POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#       OPENAI_API_KEY=<从环境注入>
# 若使用硅基流动 bge-m3（固定维度），还需：
#       POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_SEND_DIMENSIONS=false

POWERCONTEXT_SERVER_LOGGING_LEVEL=INFO
