# ============================================================
# MiniMax 配置示例 —— 复制为 .env 后填写（.env 已被 .gitignore 忽略）
# 不要提交真实 Key。
# ============================================================

# 订阅 Key（M Plan / Token Plan，通常以 sk-cp- 开头）
# 与"按量付费 API Key"额度不互通；本比赛使用赠送的 Token Plan 订阅 Key。
MINIMAX_API_KEY=

# 区域：cn = 国内站 api.minimax.cn，io = 国际站 api.minimax.io
MINIMAX_REGION=cn

# 可选：直接覆盖 OpenAI 兼容 Base URL（留空则按 MINIMAX_REGION 推导）
# 国内站: https://api.minimax.cn/v1
# 国际站: https://api.minimax.io/v1
MINIMAX_BASE_URL=

# 模型 ID
MINIMAX_MODEL=MiniMax-M3.1-Flash

# 调用参数
MINIMAX_TIMEOUT=180
MINIMAX_MAX_RETRIES=3

# 思考深度（仅 MiniMax-M3.1-Flash 生效）：low / medium / high / xhigh / max
MINIMAX_REASONING_EFFORT=max

# 调用记录目录（JSONL，用于"技术使用记录"）
MINIMAX_LOG_DIR=records/minimax
