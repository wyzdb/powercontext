# Copy to .env and fill in the real values. .env is git-ignored.

# MiniMax -------------------------------------------------------------------
MINIMAX_API_KEY=sk-api-your-token-plan-key
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M3

# seekdb --------------------------------------------------------------------
SDD_SEEKDB_HOST=127.0.0.1
SDD_SEEKDB_PORT=2881
SDD_SEEKDB_USER=root
SDD_SEEKDB_PASSWORD=
SDD_SEEKDB_DATABASE=sdd

# PowerContext --------------------------------------------------------------
POWERCONTEXT_SERVER_URL=http://127.0.0.1:8765
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8765
POWERCONTEXT_SERVER_DATABASE_KIND=sqlite
# Absolute SQLite path for the server-side state database.
# Windows:
POWERCONTEXT_SERVER_DATABASE_URL=sqlite+aiosqlite:///C:/absolute/path/to/minimax/.state/powercontext.db
# Linux / macOS:
# POWERCONTEXT_SERVER_DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/minimax/.state/powercontext.db
