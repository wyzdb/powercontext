# PowerContext 本地 Server 配置（SQLite + 关闭认证，仅本机使用）
# 启动：powercontext server run --env-file config/powercontext.env
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=18080
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=false
POWERCONTEXT_SERVER_ACCESS_MODE=disabled

# 数据目录放在仓库内，避免写系统目录；相对于启动时的工作目录（minimax/）
POWERCONTEXT_HOME=./state/powercontext
