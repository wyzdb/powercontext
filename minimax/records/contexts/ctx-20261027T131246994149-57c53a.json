    },
    {
      "clause_id": "SPEC-ORD-001/R2",
      "spec_id": "SPEC-ORD-001",
      "title": "订单列表分页",
      "version": 4,
      "status": "active",
      "heading": "total 与 pages 的语义",
      "body": "`total` 是过滤后的记录总数，`pages` 是 `ceil(total / page_size)`；两者都不能按过滤前的集合计算。响应必须回显调用方实际使用的 `page` 与 `page_size`。",
      "role": "constraint",
